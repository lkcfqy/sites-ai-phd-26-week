{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "check:api": "node scripts/check-api.mjs",
    "check:learning": "node scripts/check-learning-api.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "preview:acceptance": "node scripts/preview-acceptance.mjs",
    "check:autonomous": "node scripts/check-autonomous.mjs",
    "check:depth": "node scripts/check-depth.mjs && node scripts/check-depth-math.mjs && node scripts/check-depth-ui.mjs",
    "check:self-study": "node scripts/check-self-study.mjs",
    "check:systems": "node --experimental-strip-types scripts/check-systems.mjs",
    "check:validation": "node --experimental-strip-types --test --test-concurrency=1 scripts/check-validation.mjs",
    "check:evidence": "node --test --test-concurrency=1 scripts/check-systems-evidence.mjs scripts/check-extended-evidence.mjs",
    "check:assessment": "node --test --test-concurrency=1 scripts/check-assessment.mjs scripts/check-assessment-review.mjs",
    "check:foundations": "node --test --test-concurrency=1 scripts/check-foundations.mjs",
    "check:simulation": "node --test --test-concurrency=1 scripts/check-simulation.mjs",
    "check:cli": "node --test --test-concurrency=1 scripts/check-log-cli.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fast-uri": "3.1.9",
    "sharp": "0.35.5",
    "baseline-browser-mapping": "2.11.0",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "@babel/core": "7.29.6",
    "browserslist": "4.28.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@>=3.0.0": "5.0.12",
    "js-yaml": "4.3.2",
    "satori": {
      "fflate": "0.7.5"
    },
    "image-size": "2.0.3",
    "ws": "8.21.0",
    "esbuild@^0.28.0": "0.28.1"
  }
}
